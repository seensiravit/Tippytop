# Copy to .env and fill in. `.env` is git-ignored — never commit a key.

# --- autoresearch_lg (the primary agent) ---
# Required. propose.py dispatches on the model name prefix: claude-* goes to
# Anthropic, anything else to OpenAI. Default model is claude-sonnet-5.
ANTHROPIC_API_KEY=

# Only needed if you pass a non-claude model, e.g. --model gpt-4o
OPENAI_API_KEY=

# --- src/tippytop/agent (the earlier agent; see ARCHITECTURE.md) ---
# Only needed for `python -m tippytop agent --llm gemini`.
# Not needed for --llm mock, and not used by autoresearch_lg at all.
# Key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
