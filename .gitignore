# Data — downloaded separately (~280 MB), never commit.
# ./KuaiRand-Pure is normally a junction to wherever the archive was unpacked.
KuaiRand-Pure/
KuaiRand-Pure.tar.gz

# Secrets — never commit API keys
.env
.env.*
!.env.example

# Agent run artifacts (autoresearch_lg) — scratch by default: every `setup`
# archives the previous run's copies, so the root ones are transient.
runs/
run.log
results.tsv
concepts.json
checkpoints.db
.autoresearch_start_time
autoresearch_lg_graph.mmd
results_dashboard.html
.langgraph_api/

# Generated submissions (keep the directory, not the files)
submission*.csv
results/submissions/*.csv
results/runs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# ...EXCEPT the final run. runs.jsonl, resource_report.json and the submission
# are graded deliverables (per-iteration hypothesis/diff/metrics/recovery, and
# total tokens + wall-clock + iterations), and a grader cannot see files that
# are not in the repository. Copy the chosen run's artifacts here and commit.
!results/final_run/
!results/final_run/**
